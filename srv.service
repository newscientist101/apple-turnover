[Unit]
Description=Go web server

[Service]
Type=simple
User=exedev
Group=exedev
# WorkingDirectory and ExecStart track this checkout and `make build` output:
# srv/ is a package directory, so `go build -o srv` writes srv/srv inside it.
WorkingDirectory=/home/exedev/strudel-agent
ExecStart=/home/exedev/strudel-agent/srv/srv
Restart=always
RestartSec=5
Environment=HOME=/home/exedev
Environment=USER=exedev
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
